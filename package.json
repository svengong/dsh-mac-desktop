{
  "name": "dsh-mac-desktop",
  "version": "0.10.6",
  "private": true,
  "description": "Desktop shell for the DeepSeek Harness web app on macOS, Windows and Linux: local or SSH-remote connections with an in-menu update flow",
  "homepage": "https://github.com/svengong/dsh-mac-desktop",
  "desktopName": "com.deepseek.harness.desktop",
  "author": {
    "name": "svengong",
    "email": "svengong@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svengong/dsh-mac-desktop.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-desktop",
    "deepseek-harness-desktop",
    "ai-agents",
    "electron",
    "macos",
    "windows",
    "arm64",
    "x64",
    "ssh"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "icons": "bash scripts/gen-icons.sh",
    "dist": "electron-builder --mac dir",
    "dist:dmg": "electron-builder --mac dmg zip",
    "dist:win": "node scripts/build-win.js",
    "dist:win:arm64": "node scripts/build-win.js --arm64",
    "dist:win:x64": "node scripts/build-win.js --x64",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:x64": "electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "dist:publish": "electron-builder --mac dmg zip --publish always",
    "dist:publish:win": "node scripts/build-win.js --publish always",
    "dist:publish:linux": "electron-builder --linux AppImage deb --publish always"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "artifactName": "dsh-mac-desktop-${version}-macos-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "svengong",
        "repo": "dsh-mac-desktop"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "build/iconPressed.png",
      "build/trayTemplate*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "DeepSeek Harness 需要访问局域网设备以建立 SSH 隧道并连接远程 harness 服务。"
      },
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "dsh-desktop-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness",
      "artifactName": "dsh-desktop-${version}-windows-${arch}-setup.${ext}",
      "uninstallDisplayName": "DeepSeek Harness ${version}"
    },
    "portable": {
      "artifactName": "dsh-desktop-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "deepseek-harness",
      "syncDesktopName": true,
      "synopsis": "Desktop shell for the DeepSeek Harness web app",
      "description": "Loads the DeepSeek Harness web UI in a native window and keeps the resident dsh web service deployed and up to date, locally or over SSH.",
      "maintainer": "svengong <svengong@users.noreply.github.com>",
      "vendor": "svengong",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "dsh-desktop-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "dsh-desktop-${version}-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  }
}
